EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Telemetría remota de errores (Sentry). Opcional: si se deja vacío, Sentry queda
# deshabilitado y trackError sigue registrando en memoria + consola.
EXPO_PUBLIC_SENTRY_DSN=

# Analíticas de producto (PostHog). Opcional: sin key, los eventos quedan en
# memoria + consola. El host por defecto es US cloud (https://us.i.posthog.com).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
