{
  "expo": {
    "name": "ARISE — 90 Day Challenge",
    "slug": "arise-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "arise",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teopalatini.arise",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "ARISE no usa tu cámara.",
        "NSPhotoLibraryUsageDescription": "ARISE no accede a tus fotos.",
        "NSCalendarsUsageDescription": "ARISE agrega tus misiones y bloques de entrenamiento a tu calendario.",
        "NSRemindersUsageDescription": "ARISE puede crear recordatorios para tus misiones diarias.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05050A"
      },
      "package": "com.teopalatini.arise",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-calendar",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8460A",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd3339e1-0597-408a-9151-198a23ab3c9d"
      }
    },
    "owner": "capocha"
  }
}
